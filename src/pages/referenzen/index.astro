---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import LogoMarquee from "../../components/LogoMarquee.astro";
import CaseStats from "../../components/CaseStats.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import UpcomingCase from "../../components/UpcomingCase.astro";
import WebsiteDemo from "../../components/WebsiteDemo.astro";
import CtaSection from "../../components/CtaSection.astro";
import VideoPlaceholder from "../../components/VideoPlaceholder.astro";
import { flagshipCase, upcomingCases, testimonials } from "../../data/site";
import { url } from "../../lib/url";
---
<Layout
  title="Referenzen & Ergebnisse | Steinhauer Media"
  description="Ausgewählte Projekte von Steinhauer Media – darunter eine Kampagne mit 142 Anfragen bei 17,60 € pro Anfrage für ein lokales Laser-Studio in Regensburg."
  slug="referenzen"
  navActive="referenzen"
  crumbs={[{ label: "Referenzen" }]}
>
  <PageHero
    kicker="Referenzen"
    heading="Ergebnisse statt Eitelkeits-Metriken."
    lead="Ausgewählte Projekte und Kampagnen, die zeigen, wie wir arbeiten."
    crumbs={[{ label: "Referenzen" }]}
  />

  <section class="pb-16">
    <div class="wrap">
      <p class="reveal text-ivory-dim text-sm mb-8">Vertraut von</p>
      <LogoMarquee />
    </div>
  </section>

  <section id="case-google-ads" class="pb-24 md:pb-28">
    <div class="wrap">
      <div class="reveal max-w-xl">
        <h2 class="text-[clamp(1.6rem,3.6vw,2.3rem)]">{flagshipCase.title}</h2>
        <p class="text-ivory-dim mt-3 text-sm">{flagshipCase.subtitle}</p>
      </div>
      <CaseStats stats={flagshipCase.stats} class="mt-10" />
      <div class="reveal-stagger grid sm:grid-cols-2 md:grid-cols-4 gap-8 mt-14">
        {flagshipCase.breakdown.map((b) => (
          <div>
            <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-ivory-faint">{b.heading}</h3>
            <p class="text-ivory-dim text-sm mt-2.5 leading-relaxed">{b.text}</p>
          </div>
        ))}
      </div>
      <RelatedLinks intro="Passende Leistung:" links={[{ slug: "google-ads-agentur-konstanz", label: "Google & Meta Ads" }]} />
    </div>
  </section>

  <section class="pb-24 md:pb-28">
    <div class="wrap">
      <div class="reveal max-w-xl mb-10">
        <p class="kicker">Weitere Projekte</p>
        <h2 class="mt-4 text-[clamp(1.5rem,3.2vw,2.1rem)]">Case Studies in Vorbereitung.</h2>
        <p class="text-ivory-dim mt-3 text-sm leading-relaxed">Diese Projekte laufen bereits — die vollständigen Ergebnisse veröffentlichen wir hier, sobald sie final ausgewertet und freigegeben sind.</p>
      </div>
      <div class="reveal-stagger grid md:grid-cols-2 gap-5">
        {upcomingCases.map((c) => (
          <UpcomingCase id={c.id} name={c.name} category={c.category} blurb={c.blurb} fields={c.fields} related={c.related} />
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24 md:pb-28">
    <div class="wrap">
      <div class="reveal max-w-xl mb-10">
        <p class="kicker">Kundenstimmen</p>
        <h2 class="mt-4 text-[clamp(1.5rem,3.2vw,2.1rem)]">Referenz-Videos &amp; O-Töne.</h2>
        <p class="text-ivory-dim mt-3 text-sm leading-relaxed">Das sagen Kunden über die Zusammenarbeit mit uns.</p>
      </div>
      <div class="reveal-stagger grid md:grid-cols-3 gap-8 justify-items-center">
        {testimonials.map((t) => (
          <div class="flex flex-col items-center gap-4 w-full max-w-[230px]">
            <div class="relative w-full rounded-[1.6rem] p-2 bg-gradient-to-b from-lime/60 via-lime/20 to-transparent shadow-[0_0_45px_-12px_rgba(201,166,104,0.45)]">
              {t.type === "video" ? (
                <VideoPlaceholder title={`Kundenstimme — ${t.company}`} label="Video-Testimonial" src={url(t.src)} poster={url(t.poster!)} />
              ) : (
                <img
                  src={url(t.src)}
                  alt={`Kundenstimme von ${t.name}, ${t.company}`}
                  class="aspect-[9/16] w-full rounded-2xl object-cover"
                  loading="lazy"
                />
              )}
            </div>
            <div class="text-center">
              <p class="text-sm text-ivory">{t.name}</p>
              <p class="text-xs text-lime mt-0.5">{t.company}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24 md:pb-32">
    <div class="wrap">
      <WebsiteDemo
        heading="Interaktive Webseiten-Vorschau"
        lead="Statt PDF-Konzepten liefern wir einen echten, klickbaren Live-Prototyp — direkt am Smartphone oder Desktop testbar, bevor überhaupt eine Entscheidung fällt."
      />
    </div>
  </section>

  <CtaSection heading="Ihr Projekt könnte das nächste sein." />
</Layout>
