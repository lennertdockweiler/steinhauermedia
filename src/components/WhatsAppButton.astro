---
import { company } from "../data/site";
const phone = company.phones[0].href.replace("+", "");
const text = encodeURIComponent("Hallo Steinhauer Media, ich interessiere mich für eine kostenlose Potenzialanalyse.");
---
<!-- Floating WhatsApp shortcut, mobile only — on desktop the phone/WhatsApp links live on /kontakt/ -->
<a
  href={`https://wa.me/${phone}?text=${text}`}
  target="_blank"
  rel="noopener"
  aria-label="Per WhatsApp schreiben"
  class="md:hidden fixed bottom-5 right-5 z-40 w-14 h-14 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-[0_8px_24px_-6px_rgba(0,0,0,0.6)] active:scale-95 transition-transform"
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
