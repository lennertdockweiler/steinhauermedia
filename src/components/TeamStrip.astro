---
import { team } from "../data/site";
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
---
<div class={`grid sm:grid-cols-2 gap-6 ${detailed ? "" : "max-w-2xl"}`}>
  {team.map((member) => (
    <div class="reveal rounded-2xl border border-canvas-line bg-canvas-soft p-7">
      <img src={`/images/${member.photo}`} alt={`${member.name}, ${member.role} bei Steinhauer Media`} width="72" height="72" class="w-16 h-16 rounded-full object-cover" />
      <h3 class="font-display text-lg font-semibold mt-5">{member.name}</h3>
      <p class="text-lime text-[0.8rem] tracking-[0.04em] mt-1">{member.role}</p>
      {detailed ? (
        <ul class="mt-4 flex flex-col gap-1.5 text-sm text-ivory-dim">
          {member.responsibilities.map((r) => <li>{r}</li>)}
        </ul>
      ) : (
        <p class="text-ivory-dim text-sm mt-3 leading-relaxed">Verantwortlich für {member.responsibilities.join(", ")}.</p>
      )}
    </div>
  ))}
</div>
