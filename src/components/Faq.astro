---
interface Item { q: string; a: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="flex flex-col divide-y divide-canvas-line border-t border-b border-canvas-line">
  {items.map((item) => (
    <details class="group py-5">
      <summary class="flex items-center justify-between gap-6 cursor-pointer list-none font-medium text-[0.98rem]">
        <span>{item.q}</span>
        <span class="shrink-0 w-6 h-6 rounded-full border border-canvas-line flex items-center justify-center text-sm transition-transform duration-300 group-open:rotate-45">+</span>
      </summary>
      <p class="text-ivory-dim text-sm leading-relaxed mt-3.5 max-w-2xl">{item.a}</p>
    </details>
  ))}
</div>
