---
import { processSteps } from "../data/site";
---
<section data-process class="py-20 md:py-28 border-y border-canvas-line bg-canvas-soft">
  <div class="wrap">
    <div class="reveal max-w-lg mb-12">
      <p class="kicker">Prozess</p>
      <h2 class="mt-4 text-[clamp(1.6rem,3.4vw,2.4rem)]">Social Media, das planbar Kunden bringt.</h2>
      <p class="text-ivory-dim mt-3">Von der ersten Idee bis zum Umsatz — ein durchdachter Prozess statt Zufallstreffer.</p>
    </div>

    <div class="h-[2px] w-full bg-canvas-line rounded-full overflow-hidden mb-10" aria-hidden="true">
      <i data-process-fill class="block h-full w-full bg-lime origin-left" style="transform: scaleX(0);"></i>
    </div>

    <div class="reveal-stagger grid sm:grid-cols-2 md:grid-cols-4 gap-5">
      {processSteps.map((step, i) => (
        <div class="rounded-2xl border border-canvas-line bg-canvas p-6" data-tilt>
          <span class="font-display text-lime text-xs tracking-[0.15em]">{String(i + 1).padStart(2, "0")} — {step.num}</span>
          <h3 class="font-display text-lg font-semibold mt-3">{step.heading}</h3>
          <p class="text-ivory-dim text-sm mt-2 leading-relaxed">{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
