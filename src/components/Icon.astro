---
interface Props {
  name: "shortform" | "seo" | "ads" | "recruiting" | "webdesign" | "arrow" | "plus" | "check";
  class?: string;
  draw?: boolean;
}
const { name, class: klass = "w-8 h-8", draw = false } = Astro.props;
const drawAttr = draw ? { "data-draw": true } : {};
---

{name === "shortform" && (
  <svg class={klass} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" {...drawAttr}>
    <path d="M14 12L28 20L14 28V12Z" />
  </svg>
)}
{name === "seo" && (
  <svg class={klass} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" {...drawAttr}>
    <circle cx="17" cy="17" r="10" /><path d="M25 25L33 33" />
  </svg>
)}
{name === "ads" && (
  <svg class={klass} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" {...drawAttr}>
    <circle cx="20" cy="20" r="12" /><circle cx="20" cy="20" r="5" /><circle cx="20" cy="20" r="1.4" fill="currentColor" />
  </svg>
)}
{name === "recruiting" && (
  <svg class={klass} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" {...drawAttr}>
    <path d="M10 30V22C10 18 14 15 20 15C26 15 30 18 30 22V30" /><circle cx="20" cy="10" r="4" />
  </svg>
)}
{name === "webdesign" && (
  <svg class={klass} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" {...drawAttr}>
    <rect x="8" y="9" width="24" height="18" /><path d="M8 15H32" /><path d="M14 31H26" />
  </svg>
)}
{name === "arrow" && (
  <svg class={klass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M6 18L18 6M18 6H9M18 6V15" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === "plus" && (
  <svg class={klass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M12 5V19M5 12H19" stroke-linecap="round" />
  </svg>
)}
{name === "check" && (
  <svg class={klass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M4 12.5L9.5 18L20 6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
