---
import { clientLogos } from "../data/site";
import { url } from "../lib/url";
---
<div class="marquee-row overflow-hidden">
  <div class="marquee-track">
    {[...clientLogos, ...clientLogos].map((logo) => (
      <div class="shrink-0 px-8 flex items-center">
        <img src={url(`/images/${logo.file}`)} alt={logo.alt} width="280" height="70" loading="lazy" class="h-12 md:h-14 w-auto max-w-[180px] object-contain opacity-90 hover:opacity-100 transition-opacity duration-300" />
      </div>
    ))}
  </div>
</div>
