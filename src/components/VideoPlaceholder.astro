---
interface Props {
  title: string;
  label?: string;
  class?: string;
}
const { title, label = "Video-Platzhalter", class: klass = "" } = Astro.props;
---
<div class={`reveal relative aspect-[9/16] w-full rounded-2xl border border-dashed border-canvas-line bg-canvas-soft overflow-hidden flex flex-col items-center justify-center gap-4 p-6 text-center ${klass}`}>
  <div class="absolute inset-0 opacity-[0.08]" style="background-image: linear-gradient(150deg, var(--color-lime) 0%, transparent 55%);" aria-hidden="true"></div>
  <div class="relative w-14 h-14 rounded-full border border-canvas-line bg-canvas flex items-center justify-center shrink-0">
    <svg class="w-5 h-5 text-lime translate-x-[1px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
  </div>
  <div class="relative">
    <p class="text-[0.65rem] uppercase tracking-[0.12em] text-ivory-faint">{label}</p>
    <p class="mt-1.5 text-sm font-medium text-ivory-dim leading-snug">{title}</p>
  </div>
</div>
