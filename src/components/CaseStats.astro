---
interface Stat { value: number; decimals?: number; prefix?: string; suffix?: string; label: string }
interface Props { stats: Stat[]; class?: string }
const { stats, class: klass = "" } = Astro.props;
---
<div class={`reveal-stagger grid grid-cols-2 md:grid-cols-4 gap-4 ${klass}`}>
  {stats.map((s) => (
    <div class="rounded-2xl border border-canvas-line bg-canvas-soft px-5 py-6 text-center">
      <div
        class="font-display text-2xl md:text-3xl font-semibold text-lime"
        data-count={s.value}
        data-decimals={s.decimals ?? 0}
        data-prefix={s.prefix ?? ""}
        data-suffix={s.suffix ?? ""}
      >{(s.prefix ?? "") + s.value.toFixed(s.decimals ?? 0).replace(".", ",") + (s.suffix ?? "")}</div>
      <div class="text-ivory-dim text-xs mt-2">{s.label}</div>
    </div>
  ))}
</div>
